# Firebase (cliente)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Servidor
FIREBASE_PROJECT_ID=
# ID de la hoja de cálculo de la Master (o de su copia de pruebas en staging)
MASTER_SPREADSHEET_ID=
# Prefijo de colecciones: "prod" o "staging"
DATA_NAMESPACE=staging
# Correos con rol admin, separados por comas
ADMIN_EMAILS=

# Secretos (en producción viven en Secret Manager)
SYNC_SECRET=
CRON_SECRET=

# Sincronización (ver docs/sincronizacion.md)
# De dónde se lee la Master: "sheets" o "file" (por defecto, "sheets" si hay MASTER_SPREADSHEET_ID)
MASTER_SOURCE=
# Archivo JSON que se lee con MASTER_SOURCE=file (por defecto, fixtures/private/master.json)
MASTER_LOCAL_FILE=
# Dónde se guardan los datos: "firestore" o "memory" (por defecto, "firestore" si hay FIREBASE_PROJECT_ID)
STORE=
